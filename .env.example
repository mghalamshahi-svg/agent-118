# Copy this file to .env and fill in real values before running.

PORT=3300

# --- WordPress (globallink-leads plugin) -----------------------------------
# Base URL of the WP site running the globallink-leads plugin.
WP_BASE_URL=https://tradehub.globallink.example

# Preferred auth: copy this from wp-admin > GlobalLink Leads > تنظیمات
# (the plugin generates it automatically on activation). Works even when
# WordPress's own Application Passwords feature is disabled/hidden by your
# host or a security plugin, which is common.
WP_SERVICE_KEY=

# Fallback auth (only used if WP_SERVICE_KEY is empty): a WordPress
# Application Password, created under wp-admin > Users > your user >
# Application Passwords — only works if that feature is available on your
# host.
WP_APP_USERNAME=
WP_APP_PASSWORD=

# --- Speech-to-text ----------------------------------------------------------
# OpenAI Whisper API (recommended per the plan doc for Persian accuracy).
OPENAI_API_KEY=sk-...
# Alternative: set STT_PROVIDER=google and fill GOOGLE_APPLICATION_CREDENTIALS
# to a service-account JSON path if you'd rather use Google Cloud STT.
STT_PROVIDER=openai

# --- Intent extraction (NLU) -------------------------------------------------
# Either Anthropic or OpenAI works — pick one, the prompt is provider-agnostic.
NLU_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
NLU_MODEL=claude-sonnet-4-5
# If NLU_PROVIDER=openai instead:
# NLU_MODEL=gpt-4o-mini

# --- Misc --------------------------------------------------------------------
# Comma-separated list of allowed CORS origins (the Expo app's dev/prod URLs).
CORS_ORIGINS=http://localhost:19006,https://tradehub.globallink.example
